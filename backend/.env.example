# Cashing-go Backend Environment Variables
# Copie este arquivo para .env e preencha os valores

# === PRIMARY ===
Fy_PRIMARY_ENV=local

# === SERVER ===
Fy_SERVER_PORT=3000
Fy_SERVER_READ_TIMEOUT=30
Fy_SERVER_WRITE_TIMEOUT=30
Fy_SERVER_IDLE_TIMEOUT=60
Fy_SERVER_CORS_ALLOWED_ORIGINS=http://localhost:4000,http://localhost:3000

# === TLS/HTTPS (Produção) ===
# Descomente para habilitar HTTPS
# Fy_SERVER_TLS_ENABLED=true
# Fy_SERVER_TLS_CERT_FILE=/path/to/cert.pem
# Fy_SERVER_TLS_KEY_FILE=/path/to/key.pem

# === DATABASE ===
Fy_DATABASE_HOST=
Fy_DATABASE_PORT=
Fy_DATABASE_USER=
Fy_DATABASE_PASSWORD=
Fy_DATABASE_DB_NAME=
# Fy_DATABASE_SSL_MODE=disable

# Configurações avançadas (opcional)
# Fy_DATABASE_MAX_OPEN_CONNS=25
# Fy_DATABASE_MAX_IDLE_CONNS=5
# Fy_DATABASE_CONN_MAX_LIFETIME=300
# Fy_DATABASE_CONN_MAX_IDLE_TIME=60

# === AUTH ===
# IMPORTANTE: Use uma chave forte (min 32 caracteres) em produção
Fy_AUTH_SECRET_KEY=your-secret-key-min-32-chars-change-in-production

# Token durations
Fy_AUTH_ACCESS_TOKEN_DURATION=
Fy_AUTH_REFRESH_TOKEN_DURATION=
Fy_AUTH_ISSUER=cashing-api

# === REDIS ===
Fy_REDIS_ADDRESS=localhost:6379
# Fy_REDIS_PASSWORD=
# Fy_REDIS_DB=0

# === FIREBASE (Social Login - Opcional) ===
Fy_FIREBASE_ENABLED=false
# Fy_FIREBASE_PROJECT_ID=your-project-id
# Fy_FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
# Ou use JSON diretamente:
# Fy_FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# === INTEGRATION ===
# Email service (Resend)
# Fy_INTEGRATION_RESEND_API_KEY=re_xxxxxxxxxxxxx

# === OBSERVABILITY (Opcional) ===
# Fy_OBSERVABILITY_SERVICE_NAME=cashing-api
# Fy_OBSERVABILITY_ENVIRONMENT=production
# Fy_OBSERVABILITY_LOGGING_LEVEL=info
# Fy_OBSERVABILITY_LOGGING_FORMAT=json

# New Relic (opcional)
# Fy_OBSERVABILITY_NEW_RELIC_LICENSE_KEY=
# Fy_OBSERVABILITY_NEW_RELIC_APP_LOG_FORWARDING_ENABLED=true
# Fy_OBSERVABILITY_NEW_RELIC_DISTRIBUTED_TRACING_ENABLED=true

# Health checks (opcional)
# Fy_OBSERVABILITY_HEALTH_CHECKS_ENABLED=true
# Fy_OBSERVABILITY_HEALTH_CHECKS_INTERVAL=30
# Fy_OBSERVABILITY_HEALTH_CHECKS_TIMEOUT=5
