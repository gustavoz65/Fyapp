# Cashing-go Backend Environment Variables
# Copie este arquivo para .env e preencha os valores

# === PRIMARY ===
FINEXT_PRIMARY_ENV=local

# === SERVER ===
FINEXT_SERVER_PORT=3000
FINEXT_SERVER_READ_TIMEOUT=30
FINEXT_SERVER_WRITE_TIMEOUT=30
FINEXT_SERVER_IDLE_TIMEOUT=60
FINEXT_SERVER_CORS_ALLOWED_ORIGINS=http://localhost:4000,http://localhost:3000

# === TLS/HTTPS (Produção) ===
# Descomente para habilitar HTTPS
# FINEXT_SERVER_TLS_ENABLED=true
# FINEXT_SERVER_TLS_CERT_FILE=/path/to/cert.pem
# FINEXT_SERVER_TLS_KEY_FILE=/path/to/key.pem

# === DATABASE ===
FINEXT_DATABASE_HOST=localhost
FINEXT_DATABASE_PORT=3306
FINEXT_DATABASE_USER=root
FINEXT_DATABASE_PASSWORD=senha123
FINEXT_DATABASE_DB_NAME=cashing
# FINEXT_DATABASE_SSL_MODE=disable

# Configurações avançadas (opcional)
# FINEXT_DATABASE_MAX_OPEN_CONNS=25
# FINEXT_DATABASE_MAX_IDLE_CONNS=5
# FINEXT_DATABASE_CONN_MAX_LIFETIME=300
# FINEXT_DATABASE_CONN_MAX_IDLE_TIME=60

# === AUTH ===
# IMPORTANTE: Use uma chave forte (min 32 caracteres) em produção
FINEXT_AUTH_SECRET_KEY=your-secret-key-min-32-chars-change-in-production

# Token durations
FINEXT_AUTH_ACCESS_TOKEN_DURATION=15
FINEXT_AUTH_REFRESH_TOKEN_DURATION=168
FINEXT_AUTH_ISSUER=cashing-api

# === REDIS ===
FINEXT_REDIS_ADDRESS=localhost:6379
# FINEXT_REDIS_PASSWORD=
# FINEXT_REDIS_DB=0

# === FIREBASE (Social Login - Opcional) ===
FINEXT_FIREBASE_ENABLED=false
# FINEXT_FIREBASE_PROJECT_ID=your-project-id
# FINEXT_FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
# Ou use JSON diretamente:
# FINEXT_FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# === INTEGRATION ===
# Email service (Resend)
# FINEXT_INTEGRATION_RESEND_API_KEY=re_xxxxxxxxxxxxx

# === OBSERVABILITY (Opcional) ===
# FINEXT_OBSERVABILITY_SERVICE_NAME=cashing-api
# FINEXT_OBSERVABILITY_ENVIRONMENT=production
# FINEXT_OBSERVABILITY_LOGGING_LEVEL=info
# FINEXT_OBSERVABILITY_LOGGING_FORMAT=json

# New Relic (opcional)
# FINEXT_OBSERVABILITY_NEW_RELIC_LICENSE_KEY=
# FINEXT_OBSERVABILITY_NEW_RELIC_APP_LOG_FORWARDING_ENABLED=true
# FINEXT_OBSERVABILITY_NEW_RELIC_DISTRIBUTED_TRACING_ENABLED=true

# Health checks (opcional)
# FINEXT_OBSERVABILITY_HEALTH_CHECKS_ENABLED=true
# FINEXT_OBSERVABILITY_HEALTH_CHECKS_INTERVAL=30
# FINEXT_OBSERVABILITY_HEALTH_CHECKS_TIMEOUT=5
